<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Norse.AuthN.Services: the IAuthenticationService gRPC contract and its wire request/response records (LoginRequest, RegisterRequest, LoginResult, RegisterResult, LogoutResult), plus the IIdentityService disclosure contract and its wire records (GetMyPersonalDataRequest, GetMaskedPersonalDataRequest, PersonalDataResponse, MaskedPersonalDataResponse) and the IdentityPolicies/AuthNPolicies policy-name constants — no mediator marker, no [Authorize], no Razor, no FluentValidation, no Blazilla. Logout is a CancellationToken-only operation; there is no LogoutRequest. A consumer who wants the gRPC declarations without AuthN.Components' Razor components references only this assembly, wraps its own UI around IAuthenticationService/IIdentityService, and wires it to whatever backend it sees fit.</Description>
	</PropertyGroup>
	<ItemGroup>
		<NorseRef Include="Abstractions.Contracts">
			<Repo>Asgard</Repo>
		</NorseRef>
		<PackageReference Include="Microsoft.AspNetCore.Authorization" Version="11.*-*" />
		<!-- Overrides a known-vulnerable transitive version pulled in by System.ServiceModel.Primitives. -->
		<PackageReference Include="System.Security.Cryptography.Xml" Version="11.*-*" />
		<PackageReference Include="System.ServiceModel.Primitives" Version="10.*" />
		<SupportedPlatform Include="browser" />
	</ItemGroup>
</Project>
