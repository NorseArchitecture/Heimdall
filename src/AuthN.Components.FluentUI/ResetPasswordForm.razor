@inherits OutcomeFormComponentBase
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation

<PageTitle>Reset your password</PageTitle>

<h1>Reset your password</h1>
<p class="gate-subtitle">Enter your email and choose a new password.</p>

<EditForm EditContext="EditContextFor(_request)" OnSubmit="HandleResetPasswordAsync" FormName="authn-reset-password">
    <FormValidator/>
    <ModelValidationSummary/>
    <FluentTextInput @bind-Value="_request.EmailInput" Label="Email" Required="true"
        ValidationFieldFor="@((Expression<Func<Result<EmailAddress>>>)(() => _request.Email))"/>
    <FluentTextInput @bind-Value="_request.Password" TextInputType="TextInputType.Password" AutoComplete="new-password" Label="New password" Required="true"/>
    <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="!CanSubmit">Reset password</FluentButton>
</EditForm>

@code {
    /// <summary>
    ///     Authored here, once — never sourced from the wire. See <see cref="ResetPasswordAsync" /> for why
    ///     every credential failure converges on it.
    /// </summary>
    const string CredentialFailureMessage = "The reset link is invalid or has expired.";

    /// <summary>The form model — the email buffer, the opaque reset code, and the new password.</summary>
    readonly ResetPasswordRequest _request = new() { EmailInput = "" };

    /// <summary>
    ///     The opaque reset code from the emailed link. A plain parameter, not a query binding, so the story
    ///     catalog and bUnit can instantiate the form directly; the routable <see cref="ResetPassword" /> shim
    ///     reads the query, redirects when it is missing, and passes it here.
    /// </summary>
    [Parameter, EditorRequired]
    public string Code { get; set; } = "";

    /// <summary>Copies the current <see cref="Code" /> into the form model, so the latest code always submits.</summary>
    protected override void OnParametersSet() =>
        _request.Code = Code;

    /// <summary>
    ///     Dispatches the reset. No principal changes, so success is an ordinary soft navigation to the
    ///     server-resolved confirmation URL — no session transition. Field-keyed <c>Validation</c> failures
    ///     (the server's password rules) land on their fields through the base's server-error bridge.
    /// </summary>
    /// <param name="editContext">The form's edit context, validated before dispatch.</param>
    Task HandleResetPasswordAsync(EditContext editContext) =>
        SubmitAsync(editContext, ResetPasswordAsync, result => Navigation.NavigateTo(result.NextUrl));

    /// <summary>
    ///     Calls the service and recasts every credential failure to the one local message. The same failure
    ///     reaches this form in two shapes — in-process as the handler's <c>InvalidCredentials</c> carrying its
    ///     own model-error text, and over gRPC as a trailerless <c>Unauthorized</c> with no errors — so the
    ///     recast keys on the category alone, regardless of <c>Errors</c>. Every other category passes through.
    /// </summary>
    /// <param name="cancellationToken">The component-lifetime token the dispatch runs under.</param>
    /// <returns>The service's outcome, with credential failures recast.</returns>
    async Task<Outcome<NavigationResult>> ResetPasswordAsync(CancellationToken cancellationToken)
    {
        var outcome = await AuthenticationService.ResetPassword(_request, cancellationToken);
        if (outcome is Failed(var problem) &&
            problem.Category is ErrorCategory.Unauthorized or ErrorCategory.InvalidCredentials)
            return new Failed(Problem.ModelError(problem.Category, CredentialFailureMessage));

        return outcome;
    }

}
