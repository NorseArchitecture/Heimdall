@implements IDisposable

@if (_messages.Count > 0)
{
	<FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false" Class="norse-model-errors">
		@foreach (var message in _messages)
		{
			<div>@message</div>
		}
	</FluentMessageBar>
}

@code {
	IReadOnlyList<string> _messages = [];

	/// <summary>The cascaded <see cref="EditContext"/> this summary watches. Required — an <see cref="EditForm"/> ancestor must supply it.</summary>
	[CascadingParameter]
	EditContext EditContext { get; set; } = null!;

	// The EditContext this instance is actually subscribed to right now — tracked separately from
	// the cascading parameter above because a parent can replace the cascaded EditContext (a new
	// model, a re-keyed form) on a live instance without remounting it. OnParametersSet runs on every
	// such change; OnInitialized does not. Dispose reads this field, never the cascading parameter,
	// so it always unsubscribes from whatever this instance last subscribed to.
	EditContext? _subscribedContext;

	/// <inheritdoc />
	protected override void OnParametersSet()
	{
		if (EditContext is null)
			throw new InvalidOperationException($"{nameof(ModelValidationSummary)} requires a cascading EditContext — place it inside an EditForm.");

		if (ReferenceEquals(EditContext, _subscribedContext))
			return;

		if (_subscribedContext is not null)
			_subscribedContext.OnValidationStateChanged -= HandleValidationStateChanged;

		EditContext.OnValidationStateChanged += HandleValidationStateChanged;
		_subscribedContext = EditContext;
		CollectMessages();
	}

	void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
	{
		CollectMessages();
		StateHasChanged();
	}

	void CollectMessages() =>
		_messages = [.. EditContext.GetValidationMessages(new FieldIdentifier(EditContext.Model, string.Empty))];

	/// <summary>Unsubscribes from the currently tracked <see cref="EditContext"/>'s <see cref="EditContext.OnValidationStateChanged"/>.</summary>
	public void Dispose()
	{
		if (_subscribedContext is not null)
			_subscribedContext.OnValidationStateChanged -= HandleValidationStateChanged;
	}
}
