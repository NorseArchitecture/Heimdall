@page "/Account/Manage/Passkeys"
@using Microsoft.JSInterop
@inherits OutcomeComponentBase
@implements IAsyncDisposable
@inject IPasskeyService PasskeyService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Manage your passkeys</PageTitle>

<h3>Manage your passkeys</h3>

@if (_passkeys is null)
{
    @if (IsDispatching)
    {
        <Loader/>
    }
    else if (Problem is not null)
    {
        <div class="alert alert-danger" role="alert">Your passkeys could not be loaded.</div>
    }
}
else
{
    <StatusMessage Message="@_message"/>

    @if (_moduleProblem is not null)
    {
        <div class="alert alert-danger" role="alert" data-module-problem>
            @foreach (var message in ProblemMessages.Of(_moduleProblem, "Passkeys cannot be added on this page right now."))
            {
                <p>@message</p>
            }
        </div>
    }

    @if (Problem is not null)
    {
        <div class="alert alert-danger" role="alert">
            @foreach (var message in ProblemMessages.Of(Problem, _fallback))
            {
                <p>@message</p>
            }
        </div>
    }
    else if (_ceremonyError is not null)
    {
        <div class="alert alert-danger" role="alert">@_ceremonyError</div>
    }

    @if (_passkeys.Passkeys.Length > 0)
    {
        <table style="margin-top: 10px;">
            <thead>
            <tr>
                <th width="60%">Name</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var passkey in _passkeys.Passkeys)
            {
                <tr style="height: 44px;">
                    <td>@(passkey.Name.Length > 0 ? passkey.Name : "Unnamed passkey")</td>
                    <td style="display: flex; align-items: center; height: 44px; justify-content: flex-end; gap: 5px;">
                        <FluentLink Href="@passkey.RenameUrl" Title="Rename this passkey">Rename</FluentLink>
                        <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(!CanAct || _busy)" data-credential-id="@passkey.CredentialId"
                                      Title="Remove this passkey from your account"
                                      OnClick="() => DeleteAsync(passkey)">Delete</FluentButton>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p>No passkeys are registered.</p>
    }

    @* The server enforces the cap (AddPasskey answers Conflict); hiding Add here only spares a doomed ceremony. *@
    @if (_passkeys.Passkeys.Length >= MaxPasskeys)
    {
        <p class="text-danger">You have reached the maximum number of allowed passkeys.</p>
    }
    else if (_supported is false)
    {
        <p class="text-danger">Some passkey features are missing. Please update your browser.</p>
    }
    else
    {
        @* Disabled, not hidden, until support is known: a static render never learns it, and offers nothing to click. *@
        <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(!CanAct || _busy || _supported is not true)" data-action="add"
                      OnClick="AddAsync">Add a new passkey</FluentButton>
    }
}

@code {
    /// <summary>The passkey cap (a parity literal); the server enforces it, the page only hides Add at it.</summary>
    const int MaxPasskeys = 100;

    /// <summary>The caller's passkeys, loaded on initialization and again after a delete. Null until the first load succeeds.</summary>
    PasskeysResponse? _passkeys;

    /// <summary>The browser half of the ceremony, created after the first interactive render. Null under a static render.</summary>
    PasskeyModule? _module;

    /// <summary>Whether the browser can run a ceremony; null until the module answers, which a static render never asks.</summary>
    bool? _supported;

    /// <summary>
    ///     True while the browser ceremony runs. Add spans two dispatches with the ceremony between them, and the
    ///     base's in-flight guard (<c>CanAct</c>) is released in that gap; this covers exactly the gap. The
    ///     dispatches themselves are covered by <c>CanAct</c>, and Delete's two dispatches run back to back.
    /// </summary>
    bool _busy;

    /// <summary>
    ///     The module's import failure (a missing asset, a blocked script), rendered in place. Add stays disabled,
    ///     since support was never learned; Delete needs no WebAuthn and stays usable.
    /// </summary>
    Problem? _moduleProblem;

    /// <summary>The ceremony's own failure line (a dismissed prompt or an interop failure), rendered in place.</summary>
    string? _ceremonyError;

    /// <summary>The in-place success line ("Passkey deleted successfully.").</summary>
    string? _message;

    /// <summary>The page-authored line for a failure the server sends without messages, set per operation.</summary>
    string _fallback = "Your passkeys could not be loaded.";

    /// <summary>Loads the list. A loader, so it runs under a static render too and the page arrives with its data.</summary>
    protected override Task OnInitializedAsync() =>
        DispatchAsync(ct => PasskeyService.GetPasskeys(ct), passkeys => _passkeys = passkeys);

    /// <summary>
    ///     Imports the module and asks for browser support after the first interactive render only: a static
    ///     render makes no JS call, so Add stays disabled there. Disposal mid-probe ends quietly; a failed import
    ///     renders in place instead of tearing down the page.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
            return;

        _module = new(JSRuntime);
        var cancellationToken = CancellationToken;
        try
        {
            _supported = await _module.IsSupportedAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (JSException exception)
        {
            _moduleProblem = Problem.ModelError(ErrorCategory.Fault, exception.Message);
        }

        StateHasChanged();
    }

    /// <summary>
    ///     Click-to-add: the server's creation options, the browser's create ceremony, then <c>AddPasskey</c>;
    ///     success soft-navigates to the server's <c>NextUrl</c> (the new passkey's rename page). A dismissed
    ///     prompt or an interop failure renders the ceremony's line in place and calls nothing; an abort
    ///     renders nothing and calls nothing; a server refusal (the cap's <c>Conflict</c>) renders in place. A page
    ///     disposed during the ceremony writes nothing and calls nothing.
    /// </summary>
    async Task AddAsync()
    {
        if (!CanAct || _busy || _module is null)
            return;

        _message = null;
        _ceremonyError = null;
        _fallback = "The passkey was not added.";
        PasskeyCreationOptionsResponse? options = null;
        await DispatchAsync(ct => PasskeyService.GetPasskeyCreationOptions(ct), response => options = response);
        if (options is null)
            return;

        var cancellationToken = CancellationToken;
        PasskeyCeremonyResult ceremony;
        _busy = true;
        // An event handler renders only at its first yield and on completion, and the options dispatch has
        // already released CanAct; render now so the page shows the ceremony as in flight.
        StateHasChanged();
        try
        {
            ceremony = await _module.CreateAsync(options.OptionsJson, cancellationToken);
        }
        finally
        {
            _busy = false;
        }

        if (cancellationToken.IsCancellationRequested)
            return;

        if (ceremony.Error is not null)
        {
            _ceremonyError = ceremony.Error;
            return;
        }

        if (ceremony.CredentialJson is not { } credentialJson)
            return;

        await DispatchAsync(
            ct => PasskeyService.AddPasskey(new() { CredentialJson = credentialJson, AttestationState = options.AttestationState }, ct),
            result => Navigation.NavigateTo(result.NextUrl));
    }

    /// <summary>
    ///     Click-to-delete, never a state-changing GET. Success drops the entry locally, renders "Passkey deleted
    ///     successfully." in place, and reloads the list, so a failed reload never leaves the deleted row standing;
    ///     a failed delete renders in place and leaves the list as it was. The two dispatches run back to back
    ///     (no await between them yields), so <c>CanAct</c> covers the whole sequence.
    /// </summary>
    async Task DeleteAsync(PasskeyEntry passkey)
    {
        if (!CanAct || _busy)
            return;

        _message = null;
        _ceremonyError = null;
        _fallback = "The passkey could not be deleted.";
        var removed = false;
        await DispatchAsync(ct => PasskeyService.RemovePasskey(new() { CredentialId = passkey.CredentialId }, ct), _ => removed = true);
        if (!removed || _passkeys is null)
            return;

        _passkeys = _passkeys with { Passkeys = [.. _passkeys.Passkeys.Where(p => p.CredentialId != passkey.CredentialId)] };
        _message = "Passkey deleted successfully.";
        _fallback = "Your passkeys could not be loaded.";
        await DispatchAsync(ct => PasskeyService.GetPasskeys(ct), passkeys => _passkeys = passkeys);
    }

    /// <summary>
    ///     Disposes the module, then the base explicitly: implementing <see cref="IAsyncDisposable" /> means the
    ///     framework calls only this overload, so the base's <c>Dispose()</c> (which cancels the page's token)
    ///     would otherwise never run. Same discipline as <c>PersonalData</c>.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_module is not null)
            await _module.DisposeAsync();
    }

}
