@inherits OutcomeFormComponentBase
@inject IAccountService AccountService
@inject ISessionTransition SessionTransition

<EditForm EditContext="EditContextFor(_request)" OnSubmit="HandleSetPasswordAsync" FormName="authn-set-password">
    <FormValidator/>
    <ModelValidationSummary/>
    <FluentTextInput @bind-Value="_request.NewPassword" TextInputType="TextInputType.Password" AutoComplete="new-password" Label="New password" Required="true"/>
    <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="!CanSubmit">Set password</FluentButton>
</EditForm>

@code {
    /// <summary>The form model — the new password.</summary>
    readonly SetPasswordRequest _request = new();

    /// <summary>
    ///     Dispatches the set. The server refreshes the sign-in on success, so the session is re-established at
    ///     the server-resolved URL through the transition seam. A password-rule failure lands on the
    ///     new-password field; an account that already has a password renders its conflict in the summary.
    /// </summary>
    /// <param name="editContext">The form's edit context, validated before dispatch.</param>
    Task HandleSetPasswordAsync(EditContext editContext) =>
        SubmitAsync(editContext, ct => AccountService.SetPassword(_request, ct), result => SessionTransition.Begin(result));

}
