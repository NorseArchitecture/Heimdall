@page "/Account/Manage/GenerateRecoveryCodes"
@using Norse.AuthN.Components.FluentUI.Shared
@inherits OutcomeComponentBase
@inject ITwoFactorService TwoFactorService

<PageTitle>Generate two-factor authentication (2FA) recovery codes</PageTitle>

@if (_codes.Length > 0)
{
    <ShowRecoveryCodes RecoveryCodes="@_codes" StatusMessage="You have generated new recovery codes."/>
}
else
{
    <h3>Generate two-factor authentication (2FA) recovery codes</h3>
    <FluentGrid>
        <FluentGridItem sm="9">
            @if (Problem is not null)
            {
                <div class="alert alert-danger" role="alert">
                    @foreach (var message in ProblemMessages.Of(Problem, "Your recovery codes could not be generated."))
                    {
                        <p>@message</p>
                    }
                </div>
            }
            <FluentMessageBar Margin="@Margin.Bottom2" Intent="MessageBarIntent.Warning" AllowDismiss="false">Put these codes in a safe place.</FluentMessageBar>
            <p>
                If you lose your device and don't have the recovery codes you will lose access to your account.
            </p>
            <p>
                Generating new recovery codes does not change the keys used in authenticator apps. If you wish to change the key
                used in an authenticator app you should <FluentLink Href="Account/Manage/ResetAuthenticator">reset your authenticator keys.</FluentLink>
            </p>
            <p style="margin-top: 10px; text-align: end;">
                <FluentButton Appearance="ButtonAppearance.Primary" Disabled="!CanAct" OnClick="GenerateAsync">Generate Recovery Codes</FluentButton>
            </p>
        </FluentGridItem>
    </FluentGrid>
}

@code {
    /// <summary>The freshly generated recovery codes. Empty until the generation succeeds.</summary>
    string[] _codes = [];

    /// <summary>
    ///     Click-to-generate, never a state-changing GET: a bare render generates nothing. The base's dispatch
    ///     owns the disposal discipline and the in-flight guard (the button binds <c>CanAct</c>). Generation
    ///     rotates no stamp, so the new codes render in place through the shared panel — no navigation and no
    ///     transition; a failure, including the server's two-factor-off refusal, lands in <c>Problem</c> and
    ///     renders in place above the standing page.
    /// </summary>
    Task GenerateAsync() =>
        DispatchAsync(ct => TwoFactorService.GenerateRecoveryCodes(ct), response => _codes = response.RecoveryCodes);

}
