@if (Status.HasPassword)
{
    <PageTitle>Change password</PageTitle>

    <h3>Change password</h3>

    <ChangePasswordForm/>
}
else
{
    <PageTitle>Set password</PageTitle>

    <h3>Set password</h3>

    <p>You do not have a local username/password for this site. Add a local account so you can log in without an external login.</p>
    <SetPasswordForm/>
}

@code {
    /// <summary>
    ///     The caller's loaded account state. Its <see cref="AccountStatusResponse.HasPassword" /> chooses the
    ///     form and the title and heading over it: the change form under "Change password" when a password
    ///     exists, the set form (with its no-local-account copy) under "Set password" otherwise.
    ///     Shared by <see cref="ChangePassword" /> and <see cref="SetPassword" /> — both scaffold routes survive
    ///     and render the same choice, never redirecting to each other (spec §6.2).
    /// </summary>
    [Parameter, EditorRequired]
    public AccountStatusResponse Status { get; set; } = null!;

}
