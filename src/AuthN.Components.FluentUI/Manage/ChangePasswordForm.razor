@inherits OutcomeFormComponentBase
@inject IAccountService AccountService
@inject ISessionTransition SessionTransition

<EditForm EditContext="EditContextFor(_request)" OnSubmit="HandleChangePasswordAsync" FormName="authn-change-password">
    <FormValidator/>
    <ModelValidationSummary/>
    <FluentTextInput @bind-Value="_request.OldPassword" TextInputType="TextInputType.Password" AutoComplete="current-password" Label="Current password" Required="true"/>
    <FluentTextInput @bind-Value="_request.NewPassword" TextInputType="TextInputType.Password" AutoComplete="new-password" Label="New password" Required="true"/>
    <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="!CanSubmit">Update password</FluentButton>
</EditForm>

@code {
    /// <summary>The form model — the current and new passwords.</summary>
    readonly ChangePasswordRequest _request = new();

    /// <summary>
    ///     Dispatches the change. The server refreshes the sign-in on success, so the session is re-established
    ///     at the server-resolved URL through the transition seam. A wrong current password lands on the
    ///     current-password field and a password-rule failure on the new-password field, through the base.
    /// </summary>
    /// <param name="editContext">The form's edit context, validated before dispatch.</param>
    Task HandleChangePasswordAsync(EditContext editContext) =>
        SubmitAsync(editContext, ct => AccountService.ChangePassword(_request, ct), result => SessionTransition.Begin(result));

}
