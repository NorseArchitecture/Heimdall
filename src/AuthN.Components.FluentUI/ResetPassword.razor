@page "/Account/ResetPassword"
@layout GateLayout
@inject NavigationManager Navigation

@if (!string.IsNullOrEmpty(Code))
{
    <ResetPasswordForm Code="@Code"/>
}

@code {
    /// <summary>
    ///     The <c>code</c> query value the emailed reset link carries. Deliberately not stripped from the URL:
    ///     the code is single-use and the page needs it again on reload.
    /// </summary>
    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    /// <summary>
    ///     Redirects a link with no code to the invalid-reset page, replacing this history entry so the back
    ///     button does not return to a dead form. Renders nothing in that case.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Code))
            Navigation.NavigateTo("Account/InvalidPasswordReset", new NavigationOptions { ReplaceHistoryEntry = true });
    }

}
