@page "/Account/ForgotPassword"
@layout GateLayout
@inherits OutcomeFormComponentBase
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation

<PageTitle>Forgot your password?</PageTitle>

<h1>Forgot your password?</h1>
<p class="gate-subtitle">Enter your email and we'll send a reset link.</p>

<EditForm EditContext="EditContextFor(_request)" OnSubmit="HandleForgotPasswordAsync" FormName="authn-forgot-password">
    <FormValidator/>
    <ModelValidationSummary/>
    <FluentTextInput @bind-Value="_request.EmailInput" Label="Email" Required="true"
        ValidationFieldFor="@((Expression<Func<Result<EmailAddress>>>)(() => _request.Email))"/>
    <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="IsSubmitting">Send reset link</FluentButton>
</EditForm>

<p class="gate-cross-link">Remembered it? <a href="Account/Login">Log in</a></p>

@code {
    /// <summary>The form model — the email buffer whose assignment stamps the wire scalar.</summary>
    readonly ForgotPasswordRequest _request = new() { EmailInput = "" };

    /// <summary>
    ///     Dispatches the reset-link request. Anti-enumeration: the server answers every address with the same
    ///     confirmation hop, and no principal changes, so success is an ordinary soft navigation to the
    ///     server-resolved URL — no session transition.
    /// </summary>
    /// <param name="editContext">The form's edit context, validated before dispatch.</param>
    Task HandleForgotPasswordAsync(EditContext editContext) =>
        SubmitAsync(editContext, ct => AuthenticationService.ForgotPassword(_request, ct),
            result => Navigation.NavigateTo(result.NextUrl));

}
