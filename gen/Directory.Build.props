<Project>
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
	<PropertyGroup>
		<!-- Roslyn generators run inside the compiler process, which is netstandard2.0 regardless of
		     the TFM of the project consuming them. -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<!-- AOT/trim analysis doesn't apply to a compile-time-only analyzer assembly. -->
		<IsAotCompatible>false</IsAotCompatible>
		<!-- Never packed on its own — bundled into the analyzers/dotnet/cs/ folder of the host
		     package that consumes it (see each host project's IncludeGeneratorInPackage target). -->
		<IsPackable>false</IsPackable>
		<!-- CS1591 (missing XML comment for publicly visible type or member): GenerateDocumentationFile
		     inherits all the way from config/Directory.Build.props into gen/ too. This project's public
		     surface — the [Generator]-attributed IIncrementalGenerator, its DiagnosticDescriptors — is
		     public only because the Roslyn generator-loading contract requires it, not because it's a
		     documented consumer-facing API; nothing outside the compiler process resolves it. -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<!-- A ProjectReference always copies its output locally regardless of project type, but a
		     PackageReference does not — CopyLocalLockFileAssemblies defaults to false for a non-exe
		     (library) project, since a library normally expects its consumers to resolve transitive
		     package dependencies themselves via the NuGet graph. In standalone/CI mode (NorseRef
		     resolves to PackageReference here), that left a NorseRef'd dependency's DLL missing from
		     this project's own bin output — the IncludeGeneratorInPackage target's hardcoded file
		     grab then fails pack with NU5019, and the forwarding hook below finds nothing in
		     @(ReferenceCopyLocalPaths) either. Forcing copy-local makes both modes behave the same. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<!--
			A ProjectReference with OutputItemType="Analyzer" only pulls THIS project's own GetTargetPath
			output into the consumer's @(Analyzer) set — never this project's transitive references. Without
			this hook, a NorseRef'd dependency's DLL (e.g. Norse.Abstractions.Emit) never reaches the
			consumer's analyzer load context and the generator dies at runtime with FileNotFoundException
			(surfaced to the consumer as CS8785). Hoisted here (not left per-project) because every gen/
			project needs the same forwarding regardless of which NorseRef dependency it declares — the
			filter is a no-op for a project that references none of the filenames below. Mirrors
			Asgard/gen/Abstractions.Contracts.Generator/Abstractions.Contracts.Generator.csproj.
		-->
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);_NorseIncludeEmitDependencyTargetPath</GetTargetPathDependsOn>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="*">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
	<Target Name="_NorseIncludeEmitDependencyTargetPath">
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="@(ReferenceCopyLocalPaths->WithMetadataValue('Filename', 'Norse.Abstractions.Emit')->WithMetadataValue('Extension', '.dll'))" IncludeRuntimeDependency="false" />
		</ItemGroup>
	</Target>
</Project>
