<Project>
	<PropertyGroup>
		<!-- Import chains through the realm-root Directory.Build.targets (shared law: Using Remove,
		     analyzer delivery), which itself chains up to Bifrost in workspace mode. The fallback
		     condition below still probes for BIFROST specifically — the realm-root file always
		     exists, so its existence stopped meaning "workspace". -->
		<_ParentTargets>
			$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))
		</_ParentTargets>
		<_BifrostTargets>
			$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../../'))
		</_BifrostTargets>
	</PropertyGroup>
	<Import Project="$(_ParentTargets)" Condition="Exists('$(_ParentTargets)')" />
	<ItemGroup Condition="!Exists('$(_BifrostTargets)')">
		<PackageReference Include="@(NorseRef->'Norse.%(Identity)')" Version="*" />
	</ItemGroup>
</Project>
