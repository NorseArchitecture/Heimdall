<Project>
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<IsTestProject>true</IsTestProject>
		<!-- CA1707 (identifiers should not contain underscores): [Fact]/[Theory] method names on this
		     platform are deliberately sentence-shaped (e.g.
		     Navigates_to_root_when_the_gateway_completes_sign_out_directly) for readability in
		     test-runner output; PascalCase-only naming would defeat the point.
		     CA1812 (avoid uninstantiated internal classes): every test project's MTP/xUnit v3 host
		     generates an `internal class XunitAutoGeneratedEntryPoint` (obj/**/net*/
		     XunitAutoGeneratedEntryPoint.cs) that the analyzer can't see instantiated anywhere in
		     source — it's invoked by the generated Main, not by traceable code.
		     CA1859 (use concrete types for improved performance): NSubstitute mocks are always held as
		     their interface type (`Substitute.For<IFoo>()` returns `IFoo`) — there is no concrete type
		     for the analyzer's suggestion to point at.
		     CA2007 (ConfigureAwait) is at war with xUnit1030 in test code: CA2007 wants every await
		     ConfigureAwait(false)'d, xUnit1030 forbids exactly that inside a [Fact] method (no
		     SynchronizationContext to avoid there, and it can bypass xUnit's own parallelization
		     limits). xUnit1030 is the authoritative rule for test code; CA2007 is meant for
		     library/production code where the awaiting context genuinely matters.
		     CA2012 (use ValueTasks correctly) false-positives on NSubstitute's
		     `.Returns(_ => ValueTask.FromResult(...))` — the analyzer can't see through the mock-config
		     delegate to confirm the ValueTask is consumed exactly once, even though it always is.
		     CS1591 (missing XML comment for publicly visible type or member): GenerateDocumentationFile
		     is on platform-wide (config/Directory.Build.props, for src/ package XML docs) and inherits
		     into tests/; public test classes/methods (public only because MTP/xUnit v3 needs
		     discoverable types) were never meant to carry doc comments.
		     IDE0051 (private member is unused): test methods here carry no access modifier — bare
		     `void`, not `public void` (house style, see root CLAUDE.md) — which C# resolves to
		     `private`. MTP/xUnit v3's source generator invokes them via generated code the analyzer
		     can't trace, so every test method reads as an unused private member. -->
		<NoWarn>$(NoWarn);CA1707;CA1812;CA1859;CA2007;CA2012;CS1591;IDE0051</NoWarn>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="*" />
		<PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="*" />
		<PackageReference Include="NSubstitute" Version="*" />
		<PackageReference Include="Shouldly" Version="*" />
		<PackageReference Include="xunit.v3.mtp-v2" Version="*" />
		<Using Include="NSubstitute" />
		<Using Include="NSubstitute.ExceptionExtensions" />
		<Using Include="Shouldly" />
		<Using Include="Xunit" />
	</ItemGroup>
</Project>
